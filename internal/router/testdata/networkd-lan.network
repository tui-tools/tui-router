# Written by omarchy-router-nics. The LAN side of the router profile: the
# gateway address, forwarding, and the DHCP server that serves the LAN.
[Match]
Name=lan0

[Network]
Address=192.0.2.1/24
IPForward=yes
DHCPServer=yes
ConfigureWithoutCarrier=yes

[DHCPServer]
PoolOffset=100
PoolSize=101
EmitDNS=yes
DNS=192.0.2.1
EmitRouter=yes
DefaultLeaseTimeSec=1h
